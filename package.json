{
  "name": "agentic-identity",
  "version": "0.6.0",
  "description": "People, agents, and the access they share: delegation, invites, links, and an audit trail.",
  "keywords": [
    "identity",
    "agents",
    "delegation",
    "permissions",
    "sharing",
    "invites",
    "audit-log",
    "cloudflare",
    "firestore",
    "netlify"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/agentic-identity.git"
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "SECURITY.md",
    "SKILL.md",
    "llms.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./cloudflare": {
      "types": "./dist/adapters/cloudflare.d.ts",
      "import": "./dist/adapters/cloudflare.js"
    },
    "./firestore": {
      "types": "./dist/adapters/firestore.d.ts",
      "import": "./dist/adapters/firestore.js"
    },
    "./netlify": {
      "types": "./dist/adapters/netlify.d.ts",
      "import": "./dist/adapters/netlify.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    },
    "./file": {
      "types": "./dist/adapters/file.d.ts",
      "import": "./dist/adapters/file.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    "./account": {
      "types": "./dist/account.d.ts",
      "import": "./dist/account.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "clean": "rm -rf dist",
    "ci:local": "npm run build && npm run typecheck && npm test"
  },
  "peerDependencies": {
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@netlify/blobs": "^11.1.7",
    "@types/node": "^22.0.0",
    "esbuild": "^0.27.7",
    "miniflare": "^4.20260730.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.155.0"
  },
  "dependencies": {
    "hono": "^4.13.14"
  },
  "bin": {
    "agentic-identity": "./dist/cli-bin.js",
    "agentic-identity-mcp": "./dist/mcp-bin.js"
  }
}
